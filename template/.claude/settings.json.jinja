{
  "outputStyle": "Beginner or non-engineer",
  "extraKnownMarketplaces": {
    "plinth": {
      "source": {
        "source": "github",
        "repo": "coolbress/plinth"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch origin)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
{% if host == 'gitlab' %}      "Bash(glab mr view:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab issue view:*)",
      "Bash(glab issue list:*)",
      "Bash(glab ci trace:*)",
      "Bash(grep -E ' Verdict$|not yet confirmed:')",
      "Bash(glab ci status:*)",
      "Bash(glab ci list:*)",
      "Bash(glab ci view:*)",
      "Bash(glab api user)",
      "Bash(glab api projects/:id)"{% else %}      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api user --jq .login)",
      "Bash(gh api 'repos/{owner}/{repo}' --jq .permissions.admin)"{% endif %}
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
{% if host == 'gitlab' %}      "Bash(glab auth status --show-token*)",
      "Bash(glab auth status -t*)",
      "Bash(glab config get token*)",
      "Bash(glab repo delete:*)",{% else %}      "Bash(gh auth token*)",
      "Bash(gh repo delete:*)",{% endif %}
{% if archetype == 'web' %}      "Bash(render:*)",
      "Read(~/.render/**)",
{% endif %}      "Bash(cat)",
      "Bash(tee:*)",
      "Bash(sed -i:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Bash(. *.env*)",
      "Bash(source *.env*)",
      "Bash(cat *.env)",
      "Bash(grep *.env)",
{% if host == 'gitlab' %}      "Read(~/.config/glab-cli/**)",
      "Read(~/Library/Application Support/glab-cli/**)"{% else %}      "Read(~/.config/gh/**)"{% endif %}
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.*.local",
        "./.env.development",
        "./.env.test",
        "./.env.staging",
        "./.env.production"{% if archetype == 'web' %},
        "~/.render"{% endif %}
      ]
    }
  }
}

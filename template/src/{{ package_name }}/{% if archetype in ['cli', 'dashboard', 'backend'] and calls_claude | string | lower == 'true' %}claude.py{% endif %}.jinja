"""Calling Claude: the one place the client is made and the model is named.

`ask(text, client)` sends one message with the system prompt in
`prompts/system.md` and returns Claude's answer. The client is passed in, so a
test passes a fake one (`tests/test_claude.py`); `make_client()` makes the
real one, from `ANTHROPIC_API_KEY` in the environment, and nothing else
does. `tests/conftest.py` fails any test that makes it.

The logs carry sizes, timings, token counts and errors, never the text of a
message or an answer: whatever a log line prints is kept wherever the logs go.
README.md, "Calls Claude", says what Anthropic keeps.
"""

from __future__ import annotations

import logging
import os
import time
from pathlib import Path
from typing import TYPE_CHECKING, Protocol

if TYPE_CHECKING:
    from anthropic.types import Message, MessageParam

#: The model every call uses. Change it here and nowhere else; the names are
#: at https://platform.claude.com/docs/en/about-claude/models/overview.
MODEL = "claude-opus-5-5"
#: The longest answer one call may return, in tokens. What a call costs
#: grows with it.
MAX_TOKENS = 16000
#: The system prompt: what Claude is told before every message.
PROMPT = Path(__file__).parent / "prompts" / "system.md"

log = logging.getLogger(__name__)


class MissingKeyError(RuntimeError):
    """`ANTHROPIC_API_KEY` is not set."""


class RefusedError(RuntimeError):
    """Claude declined to answer (`stop_reason` is `refusal`)."""


class Messages(Protocol):
    def create(
        self, *, model: str, max_tokens: int, system: str, messages: list[MessageParam]
    ) -> Message: ...


class Client(Protocol):
    """What `ask` uses of `anthropic.Anthropic`; a fake in a test has the same."""

    @property
    def messages(self) -> Messages: ...


def make_client() -> Client:
    """The real client, with the key from the environment and nowhere else."""
    key = os.environ.get("ANTHROPIC_API_KEY")
    if not key:
        raise MissingKeyError(
            "ANTHROPIC_API_KEY is not set: README.md, 'Calls Claude', says where it goes"
        )
    import anthropic

    return anthropic.Anthropic(api_key=key)


def system_prompt() -> str:
    return PROMPT.read_text(encoding="utf-8")


def ask(text: str, client: Client) -> str:
    """Claude's answer to `text`."""
    started = time.monotonic()
    try:
        reply = client.messages.create(
            model=MODEL,
            max_tokens=MAX_TOKENS,
            system=system_prompt(),
            messages=[{"role": "user", "content": text}],
        )
    except Exception as error:
        # The error's type only: some errors repeat what was sent.
        log.error(
            "claude call failed",
            extra={
                "error": type(error).__name__,
                "chars_in": len(text),
                "seconds": round(time.monotonic() - started, 3),
            },
        )
        raise
    answer = "".join(block.text for block in reply.content if block.type == "text")
    log.info(
        "claude answered",
        extra={
            "model": reply.model,
            "stop_reason": reply.stop_reason,
            "chars_in": len(text),
            "chars_out": len(answer),
            "input_tokens": reply.usage.input_tokens,
            "output_tokens": reply.usage.output_tokens,
            "seconds": round(time.monotonic() - started, 3),
        },
    )
    if reply.stop_reason == "refusal":
        raise RefusedError("Claude declined to answer this message")
    return answer

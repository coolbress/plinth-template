# {{ project_name }}: the container image of a service archetype.
#
# Base images are pinned by digest, not tag: a tag can move, a digest cannot,
{% if host == 'gitlab' %}# the same reason the pipeline is included at a commit SHA. Nothing raises
# them on GitLab Free: raise them by hand.{% else %}# the same reason Actions are pinned to commit SHAs. Dependabot's `docker`
# ecosystem raises the digests.{% endif %}

# ── build stage ───────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS build

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Dependencies before source: a source-only change reuses this layer.
COPY pyproject.toml uv.lock ./
# --locked: fails when the lockfile disagrees with pyproject, so the image
# never silently carries other versions. --no-dev: no tests or linters inside.
RUN uv sync --locked --no-install-project --no-dev

COPY src/ ./src/
COPY README.md ./
RUN uv sync --locked --no-dev
{%- if archetype == 'web' %}
# The static files (the admin's CSS and JavaScript) into the package's
# `staticfiles/`, which the run stage copies with `src/`. No secret or
# database is needed to collect them.
RUN DJANGO_SETTINGS_MODULE={{ package_name }}.settings .venv/bin/python -m django collectstatic --noinput
{%- endif %}

# ── run stage ─────────────────────────────────────────────────────────────
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# Not root: a container escape reaches less.
RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY --from=build --chown=app:app /app/.venv /app/.venv
COPY --from=build --chown=app:app /app/src /app/src
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1

USER app

{% if archetype == 'web' -%}
# The entry point is this package's __main__.py: it serves the Django project
# with uvicorn on $PORT, after refusing to start without production's settings.
{% else -%}
# The entry point is this package's __main__.py. No framework is chosen here.
{% endif -%}
CMD ["python", "-m", "{{ package_name }}"]

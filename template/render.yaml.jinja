# Render Blueprint: one web service and one Postgres, both on paid plans.
# Create them once in Render's dashboard (New > Blueprint, this repository),
# then set the Blueprint's Auto Sync to No in its Settings: Render applies a
# push that changes this file at once, redeploying without waiting for the
# checks that `autoDeployTrigger` waits for. Sync it by hand (Manual Sync)
# after such a change is merged and its checks have passed on the default
# branch. Deploys then go only through Render's GitHub integration. No Render API key
# and no production value lives in this file or the agent's session: the
# secret key is generated by Render, and the hosts are typed in its
# dashboard. Spec: https://render.com/docs/blueprint-spec
services:
  - type: web
    name: "{{ project_name }}"
    runtime: docker
    # About US $7 a month (0.5 CPU, 512 MB). `free` sleeps and is not used.
    plan: 0.5c-512mb
    # Deploy a commit to the default branch only after its checks pass.
    autoDeployTrigger: checksPass
    # Before each deploy, in the new image: a migration that fails stops the
    # deploy, and the running version keeps serving.
    preDeployCommand: python -m django migrate --no-input
    # The one route exempt from the HTTPS redirect; it does not touch the database.
    healthCheckPath: /healthz
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: {{ package_name }}.settings
      - key: DJANGO_SECRET_KEY
        generateValue: true
      # The service's onrender.com name, and a custom domain if you add one,
      # comma separated: typed in the dashboard, never here.
      - key: DJANGO_ALLOWED_HOSTS
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: "{{ project_name }}-db"
          property: connectionString

databases:
  # About US $6 a month (256 MB). `free` is deleted after 30 days and has no
  # backups, so it is not supported.
  - name: "{{ project_name }}-db"
    plan: 0.1c-256mb
    # The 1 GB the price includes. Left out, Render gives this tier 15 GB at
    # $0.30 a GB beyond the first, and a disk can grow but never shrink.
    diskSizeGB: 1
    # Only Render's private network: the app reaches it through
    # `connectionString`, and nothing on the internet can try a password.
    ipAllowList: []

{% if archetype == 'backend' %}# Render Blueprint: one background worker on a paid plan, built from the
# Dockerfile. A worker answers no web requests and runs all the time; the bot
# runs only while it does. Create it once in Render's dashboard (New >
# Blueprint, this repository), then set the Blueprint's Auto Sync to No in its
# Settings: Render applies a push that changes this file at once, redeploying
# without waiting for the checks that `autoDeployTrigger` waits for. Sync it by
# hand (Manual Sync) after such a change is merged and its checks have passed
# on the default branch. No Render API key and no token lives in this file or
# the agent's session. Spec: https://render.com/docs/blueprint-spec
services:
  - type: worker
    name: "{{ project_name }}"
    runtime: docker
    # About US $7 a month (0.5 CPU, 512 MB). A worker has no free tier.
    plan: 0.5c-512mb
    # Deploy a commit to the default branch only after its checks pass.
    autoDeployTrigger: checksPass
    dockerCommand: python -m {{ package_name }}.bot
    envVars:
      # The platform's token: typed in Render's dashboard when the Blueprint is
      # created, never here.
      - key: BOT_TOKEN
        sync: false
{%- if calls_claude | string | lower == 'true' %}
      - key: ANTHROPIC_API_KEY
        sync: false
{%- endif %}
{% elif archetype == 'dashboard' %}# Render Blueprint: one web service on a paid plan, the Streamlit page. No
# database, and no login: anyone with the service's address can read the page.
# Create it once in Render's dashboard (New > Blueprint, this repository),
# then set the Blueprint's Auto Sync to No in its Settings: Render applies a
# push that changes this file at once, redeploying without waiting for the
# checks that `autoDeployTrigger` waits for. Sync it by hand (Manual Sync)
# after such a change is merged and its checks have passed on the default
# branch. No Render API key and no production value lives in this file or the
# agent's session. Spec: https://render.com/docs/blueprint-spec
services:
  - type: web
    name: "{{ project_name }}"
    # Render's own Python, at the version `.python-version` names. A
    # `uv.lock` in the root makes Render install uv (render.com/docs/uv-version).
    runtime: python
    # About US $7 a month (0.5 CPU, 512 MB). `free` sleeps after 15 minutes
    # without a visit and takes about a minute to wake, and is not used.
    plan: 0.5c-512mb
    # Deploy a commit to the default branch only after its checks pass.
    autoDeployTrigger: checksPass
    # The lockfile as is, without the development tools.
    buildCommand: uv sync --locked --no-dev
    # One line: coolbress/plinth's floor check reads block YAML with no block
    # scalar (`>-`, `|`) and does not read a file that has one.
    startCommand: uv run --no-sync streamlit run src/{{ package_name }}/app.py --server.port $PORT --server.address 0.0.0.0 --server.headless true
    # Streamlit's own health route; it answers once the server is up.
    healthCheckPath: /_stcore/health
{%- if calls_claude | string | lower == 'true' %}
    envVars:
      # Typed in Render's dashboard when the Blueprint is created, never here.
      - key: ANTHROPIC_API_KEY
        sync: false
{%- endif %}
{% else %}# Render Blueprint: one web service and one Postgres, both on paid plans.
# Create them once in Render's dashboard (New > Blueprint, this repository),
# then set the Blueprint's Auto Sync to No in its Settings: Render applies a
# push that changes this file at once, redeploying without waiting for the
# checks that `autoDeployTrigger` waits for. Sync it by hand (Manual Sync)
# after such a change is merged and its checks have passed on the default
# branch. Deploys then go only through Render's GitHub integration. No Render API key
# and no production value lives in this file or the agent's session: the
# secret key is generated by Render, and the hosts are typed in its
# dashboard. Spec: https://render.com/docs/blueprint-spec
services:
  - type: web
    name: "{{ project_name }}"
    runtime: docker
    # About US $7 a month (0.5 CPU, 512 MB). `free` sleeps and is not used.
    plan: 0.5c-512mb
    # Deploy a commit to the default branch only after its checks pass.
    autoDeployTrigger: checksPass
    # Before each deploy, in the new image: wait up to two minutes for the
    # database (on the first deploy it is created alongside), then migrate
    # once. A migration that fails stops the deploy, and the running version
    # keeps serving.
    preDeployCommand: python -m {{ package_name }}.predeploy
    # The one route exempt from the HTTPS redirect; it does not touch the database.
    healthCheckPath: /healthz
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: {{ package_name }}.settings
      - key: DJANGO_SECRET_KEY
        generateValue: true
      # A custom domain, comma separated if more than one: typed in the
      # dashboard, never here. The service's own onrender.com name needs no
      # typing; the settings read it from Render's RENDER_EXTERNAL_HOSTNAME.
      - key: DJANGO_ALLOWED_HOSTS
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: "{{ project_name }}-db"
          property: connectionString

databases:
  # About US $6 a month (256 MB). `free` is deleted after 30 days and has no
  # backups, so it is not supported.
  - name: "{{ project_name }}-db"
    plan: 0.1c-256mb
    # The 1 GB the price includes. Left out, Render gives this tier 15 GB at
    # $0.30 a GB beyond the first, and a disk can grow but never shrink.
    diskSizeGB: 1
    # Only Render's private network: the app reaches it through
    # `connectionString`, and nothing on the internet can try a password.
    ipAllowList: []
{% endif %}
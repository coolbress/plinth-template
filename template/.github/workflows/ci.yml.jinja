name: CI
#
# Keep the caller job named `ci`. Check names are `{caller job} / {job}`, and
# the ruleset requires `ci / lint`, `ci / test` and the rest by name; a renamed
# job never reports again and the repository locks.
#
# The CI logic lives in coolbress/plinth, pinned to a commit SHA: a tag can
# move, a commit cannot. Dependabot raises the SHA. What each check does, what
# a red means and the fix:
# https://github.com/coolbress/plinth/blob/main/docs/reference/required-checks.md
# The implementation is python-ci.yml, in the same repository.

on:
  push:
    branches: [main]
  # No `branches:` filter on pull requests: a filter skips stacked pull
  # requests (base is another branch), and the diff-size limit pushes towards
  # stacking. Each piece is checked against its own base.
  # `edited` besides the default types: a retitled pull request re-runs the
  # title check, and an edited description re-reads the diff-size warning,
  # without a push (plinth #322). The whole workflow re-runs; concurrency
  # cancels the run the edit replaces.
  pull_request:
    types: [opened, synchronize, reopened, edited]
  # A review re-runs CI without a push. When a pull request changes how strict
  # the checks are, `ci / diff-size` fails until an admin approves the head;
  # the run this approval starts re-runs the latest red one, and the check
  # turns green. A dismissed approval makes it red again (plinth #586). From
  # a fork the token is read-only and cannot re-run it: the check then says
  # to use "Re-run failed jobs" on the latest red `ci / diff-size`.
  pull_request_review:
    types: [submitted, dismissed]

{% raw -%}
# A new push to a pull request cancels the previous run; main is never
# cancelled. The group is keyed on the event: with one group for every
# event, the re-run of a push's run cancelled the review run that started it,
# and the merge was refused as `cancelled` (plinth #518).
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}-${{ github.event_name }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
{%- endraw %}

# The caller's permissions are the ceiling for the reusable workflow.
permissions:
  contents: read

jobs:
  ci:
    uses: coolbress/plinth/.github/workflows/python-ci.yml@{{ plinth_sha }}
    with:
      # pyproject declares `requires-python = ">=3.12"`; testing one version
      # claims support that was never exercised. Not a matrix: a matrix would
      # rename the check to `ci / test (3.13)` and the ruleset requires `ci / test`.
      extra-python-versions: "3.13"
    # A called workflow cannot widen what its caller grants. `ci / floor-check`
    # reads the repository's labels, and labels belong to issues: without this
    # the label check reads an API error and reports `not verified` (plinth
    # #102). `ci / diff-size` reads the reviews and re-runs a red run after an
    # approval (plinth #586); from plinth v2.0.0 a call that does not grant
    # these two fails at startup, every check with it. Scoped to this job, not
    # raised for the file.
    permissions:
      contents: read
      issues: read
      pull-requests: read
      actions: write
{%- if archetype in ['backend', 'data-ml', 'web'] %}

  # The container image, checked the one way that tells it from a stub: build
  # it, run it, read what it says. A plain job here and not one in
  # python-ci.yml, which serves every archetype, so a cli or library instance
  # never carries it. A plain job's check name is its id, `image`; the `ci /`
  # names belong to the reusable workflow's jobs. The ruleset
  # `/plinth:new-project` applies requires `image` for this archetype, and a
  # Dependabot base-image bump that builds but cannot start stops here
  # (plinth #127).
  image:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false   # nothing here pushes
      - run: docker build -t image-under-test .
{%- if archetype == 'web' %}
      # The web archetype serves, so the container runs detached with
      # production-shaped settings: a key made for this run and placeholder
      # hosts, nothing real, and nothing here reaches a database. It must
      # answer /healthz, and its first log line must say it started. Never
      # `docker logs … | head`: under `pipefail`, `head` closing the pipe first
      # kills `docker logs` with SIGPIPE (plinth #151).
      - name: Start the image, ask it, and read its first log line
        run: |
          set -euo pipefail
          trap 'docker logs image-under-test || true' ERR
          docker run -d --name image-under-test -p 8000:8000 \
            -e DJANGO_SECRET_KEY="$(openssl rand -hex 32)" \
            -e DJANGO_ALLOWED_HOSTS=localhost \
            -e DATABASE_URL=postgres://image-check@localhost:5432/none \
            image-under-test
          for _ in $(seq 30); do curl -fsS http://localhost:8000/healthz && break; sleep 1; done
          curl -fsS http://localhost:8000/healthz
          out="$(docker logs image-under-test)"
          printf '%s\n' "$out" | head -1 | grep -F '"message": "started"'
{%- else %}
      # No framework is chosen yet, so the entry point has no port: the one
      # request is a run to completion, answered by its first log line. When a
      # server arrives, start the container with `-d -p`, `curl` it, and read
      # the log the same way: `out="$(docker logs image-under-test)"`, then the
      # `printf` line as it is. Never `docker logs … | head`: under `pipefail`,
      # `head` closing the pipe first kills `docker logs` with SIGPIPE, and a
      # healthy container fails the check with exit 141 (plinth #151).
      - name: Run the image and read its first log line
        run: |
          set -euo pipefail
          out="$(docker run --rm image-under-test)"
          printf '%s\n' "$out" | head -1 | grep -F '"message": "started"'
{%- endif %}
{%- endif %}

# Optional: a review signal from a third party on every ready pull request,
# reported as the check `third-party / review`. Off by default: it needs a
# reviewer account (the default is the Codex code reviewer, a ChatGPT
# subscription). It is a separate workflow because it listens to review events
# and must not be cancelled by a new push. To turn it on, put the lines below,
# uncommented, in `.github/workflows/third-party.yml`, and set its `uses:`
# ref to the full commit SHA the `ci` job above calls: the `<...>` placeholder
# is not a ref, and GitHub refuses the workflow until it is replaced. The how-to:
# https://github.com/coolbress/plinth/blob/main/docs/how-to/configure-the-third-party-reviewer.md
#
#   name: third-party
#   on:
#     pull_request:
#       types: [opened, synchronize, reopened, ready_for_review]
#     pull_request_review:
#       types: [submitted]
#   permissions:
#     contents: read
#     pull-requests: read
{% raw -%}
#   concurrency:
#     group: third-party-${{ github.event.pull_request.number }}
#     cancel-in-progress: false
{%- endraw %}
#   jobs:
#     third-party:
#       # The same full commit SHA the ci job above calls: copy it here when
#       # enabling this job. It is not rendered, so a template update never
#       # conflicts on this comment (plinth #463).
#       uses: coolbress/plinth/.github/workflows/pr-review.yml@<the full commit SHA the ci job calls>
#       with:
#         reviewer-logins: "chatgpt-codex-connector[bot]"   # whose signal counts
#         ask-comment: "@codex review"                       # posted to summon it; empty never summons

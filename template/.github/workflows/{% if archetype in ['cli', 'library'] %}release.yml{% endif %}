# Publishes this package to PyPI when a version tag (`v1.2.3`) is pushed, then
# makes a GitHub Release with generated notes. The steps a person takes once
# before the first tag: docs/how-to/publish-a-release.md.
#
# Not a required check and not part of `ci`: it runs on a tag, never on a pull
# request, so no ruleset waits for it. No job is skipped with `if:`; each job
# runs or fails, so a red run says which step stopped.
#
# No stored secret. PyPI trusts this workflow through Trusted Publishing: the
# publish job asks GitHub for a short-lived identity token (`id-token: write`)
# and PyPI accepts it only from the repository, workflow file and environment
# registered as the project's publisher. The action also signs what it
# uploads (attestations), and PyPI shows that on the project page. The
# GitHub Release also carries an SBOM, `sbom.spdx.json`: what installing the
# wheel puts in an environment.
#
# A uv workspace (`[tool.uv.workspace]` in pyproject.toml): one tag releases
# the root and every member that is a package. A root that depends on a
# member cannot be installed from PyPI unless the member is there too. The
# tag is the root's version; each member keeps its own, and a member file
# PyPI already has is skipped, not uploaded again. Each published package
# needs its own publisher on PyPI. Without a workspace, one package is built
# and published, and a file PyPI already has fails the run.
#
# A member the root's pyproject.toml lists with a prefix that ends in `-`,
#
#   [tool.plinth.release]
#   own-tags = { "<member's name>" = "<prefix>-" }
#
# is released on its own tags, apart from the root: a `v*` tag leaves it
# out, and first checks that the index has a release of each listed member
# the root depends on within the root's range: the member goes first, the
# root after.
name: Release

on:
  push:
    tags: ["v*"]

# Nothing by default; each job asks for what it uses.
permissions: {}

# Two tags pushed together publish one after the other, never at once.
concurrency:
  group: release
  cancel-in-progress: false

jobs:
  # Checks before anything leaves the repository, then builds. A tag that
  # fails here uploads nothing.
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    outputs:
      # "true" in a uv workspace: the publish job then skips a file PyPI has.
      workspace: ${{ steps.build.outputs.workspace }}
    # The index a listed member is looked up on: PyPI's, or TestPyPI's when
    # the release goes there.
    env:
      INDEX_URL: ${{ startsWith(vars.PYPI_REPOSITORY_URL, 'https://test.pypi.org/') && 'https://test.pypi.org/simple/' || 'https://pypi.org/simple/' }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The whole history, to tell whether the tagged commit is on main.
          fetch-depth: 0
          persist-credentials: false   # nothing here pushes
      # The tag is `v` and the root's version exactly. A member listed under
      # [tool.plinth.release] own-tags is read and checked here. Writes,
      # under $RUNNER_TEMP, what the steps below read: `release-listed`
      # (each listed member as a wheel's file name spells it) and
      # `release-needs` (each requirement of the root on a listed member, a
      # tab, and that member's prefix).
      - name: Check the tag against pyproject.toml's version
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import glob, os, re, sys, tomllib
          from pathlib import Path

          tag = os.environ["GITHUB_REF_NAME"]
          temp = Path(os.environ["RUNNER_TEMP"])
          STAY = "Leave this tag where it is: plinth's tag ruleset, on a repository that has it, refuses to move or delete it."

          def stop(title, text):
              print(f"::error title={title}::{text} Nothing was uploaded.")
              sys.exit(1)

          def key(name):
              return re.sub(r"[-_.]+", "-", name).lower()

          root = tomllib.loads(Path("pyproject.toml").read_text(encoding="utf-8"))
          version = root["project"]["version"]
          listed = root.get("tool", {}).get("plinth", {}).get("release", {}).get("own-tags", {})
          workspace = root.get("tool", {}).get("uv", {}).get("workspace")
          LIST = "[tool.plinth.release] own-tags in pyproject.toml"
          FIX = f"Fix {LIST} in a pull request, merge it, and tag the merged commit with a version that has no tag yet. {STAY}"
          if not isinstance(listed, dict) or not all(isinstance(v, str) for v in listed.values()):
              stop("The own-tags list cannot be read", f"{LIST} is not a table of member names and prefixes. {FIX}")

          # The workspace's members, by name: where each is and its version.
          members = {}
          if listed and not isinstance(workspace, dict):
              stop("The own-tags list cannot be read", f"{LIST} lists members, and pyproject.toml has no [tool.uv.workspace]. {FIX}")
          if listed:
              # As uv reads them: `**` crosses directories, hidden ones too.
              dirs = {d for p in workspace.get("members", []) for d in glob.glob(p, recursive=True, include_hidden=True)}
              dirs -= {d for p in workspace.get("exclude", []) for d in glob.glob(p, recursive=True, include_hidden=True)}
              for d in sorted(dirs):
                  f = Path(d) / "pyproject.toml"
                  if f.is_file():
                      project = tomllib.loads(f.read_text(encoding="utf-8")).get("project", {})
                      if "name" in project:
                          members[key(project["name"])] = project
          prefixes = {}
          for name, prefix in listed.items():
              if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*-", prefix):
                  stop("The own-tags list cannot be read", f"{LIST} gives {name} the prefix {prefix!r}: a prefix is letters, digits, dots, underscores and hyphens, and ends in a hyphen, so that its tags match *-v*. {FIX}")
              if key(name) not in members or key(name) == key(root["project"]["name"]):
                  stop("The own-tags list cannot be read", f"{LIST} lists {name}, which is not a member of this workspace. {FIX}")
              if prefix in prefixes.values():
                  stop("The own-tags list cannot be read", f"{LIST} gives two members the prefix {prefix}. {FIX}")
              prefixes[name] = prefix
          (temp / "release-listed").write_text(
              "".join(re.sub(r"[-_.]+", "_", n).lower() + "\n" for n in prefixes), encoding="utf-8")

          needs = ""
          if tag != f"v{version}":
              stop("The tag and the version differ", f"The tag is {tag}, but pyproject.toml says version = \"{version}\". {STAY} To release {version}, tag a commit on main v{version}. To release another version, change version in pyproject.toml in a pull request to one that has no tag yet, merge it, and tag the merged commit with it.")
          print(f"The tag {tag} matches pyproject.toml's version {version}.")
          for need in root["project"].get("dependencies", []):
              m = re.match(r"\s*([A-Za-z0-9][A-Za-z0-9._-]*)", need)
              for name, prefix in prefixes.items():
                  if m and key(m[1]) == key(name):
                      # Without its environment marker: the check runs on
                      # Linux, and a Windows-only need would be skipped.
                      needs += f"{need.split(';', 1)[0].strip()}\t{prefix}\n"
          for name in prefixes:
              print(f"{name} is released on its own tags ({prefixes[name]}v*), not on this one.")
          (temp / "release-needs").write_text(needs, encoding="utf-8")
          PY
      - name: Check the tagged commit is on main
        run: |
          set -euo pipefail
          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
            echo "::error title=The tag is not on main::$GITHUB_REF_NAME points at a commit that is not on main, so it never passed the checks a pull request needs. Nothing was uploaded. Leave this tag where it is: plinth's tag ruleset, on a repository that has it, refuses to move or delete a v* tag. Tag a commit on main with a version that has no tag yet."
            exit 1
          fi
          echo "$GITHUB_REF_NAME is on main."
      - name: Install uv (official release, SHA256 verified)
        env:
          GITHUB_TOKEN: ${{ github.token }}
          UV_VERSION: "0.13.7"
          UV_SHA256: "c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83"
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/uv"; mkdir -p "$d"
          f="uv-x86_64-unknown-linux-gnu.tar.gz"
          curl -fsSL --retry 3 ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} -o "$d/$f" \
            "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/$f"
          echo "${UV_SHA256}  $d/$f" | sha256sum -c -
          tar -xzf "$d/$f" -C "$d" --strip-components=1 "${f%.tar.gz}/uv" "${f%.tar.gz}/uvx"
          echo "$d" >> "$GITHUB_PATH"
      # `workspace-root` holds the root's name as a wheel's file name spells
      # it, or nothing without a workspace; the steps below read it.
      - name: Build the package, and every package of a uv workspace
        id: build
        run: |
          set -euo pipefail
          root="$(python3 - <<'PY'
          import re, tomllib
          with open("pyproject.toml", "rb") as f:
              project = tomllib.load(f)
          if "workspace" in project.get("tool", {}).get("uv", {}):
              print(re.sub(r"[-_.]+", "_", project["project"]["name"]).lower())
          PY
          )"
          printf '%s' "$root" > "$RUNNER_TEMP/workspace-root"
          if [ -n "$root" ]; then
            echo "workspace=true" >> "$GITHUB_OUTPUT"; uv build --all-packages
          else
            echo "workspace=false" >> "$GITHUB_OUTPUT"; uv build
          fi
          # A member listed under [tool.plinth.release] own-tags is released on
          # its own tags only: its files leave dist/ before anything reads it.
          # Each file is known by the Name in its own metadata, not its file
          # name, which an older build backend spells with hyphens; a file
          # whose metadata cannot be read stops the run.
          python3 - <<'PY'
          import os, re, sys, tarfile, zipfile
          from email.parser import HeaderParser
          from pathlib import Path

          listed = set(Path(os.environ["RUNNER_TEMP"], "release-listed").read_text(encoding="utf-8").split())
          if not listed:
              sys.exit(0)
          for f in sorted(Path("dist").glob("[!.]*")):
              try:
                  if f.name.endswith(".whl"):
                      with zipfile.ZipFile(f) as z:
                          (meta,) = [n for n in z.namelist() if re.fullmatch(r"[^/]+\.dist-info/METADATA", n)]
                          text = z.read(meta).decode()
                  else:
                      with tarfile.open(f) as t:
                          (meta,) = [m for m in t.getmembers() if re.fullmatch(r"[^/]+/PKG-INFO", m.name)]
                          text = t.extractfile(meta).read().decode()
                  name = HeaderParser().parsestr(text)["Name"]
              except Exception as e:
                  print(f"::error title=A built file's name could not be read::{f} has no metadata this run can read ({e!r}), so it cannot tell whether it is a member released on its own tags. Nothing was uploaded.")
                  sys.exit(1)
              if re.sub(r"[-_.]+", "_", name).lower() in listed:
                  f.unlink()
                  print(f"Left out {f}: {name} is released on its own tags.")
          PY
      # The tag is the root's version, checked above; each member has its own.
      # The install check below needs the root's wheel and, for each member,
      # the version just built, both read from the wheels' file names.
      - name: Find the workspace's root wheel and its members' versions
        run: |
          set -euo pipefail
          root="$(cat "$RUNNER_TEMP/workspace-root")"
          if [ -z "$root" ]; then
            echo "No uv workspace: one package."
            exit 0
          fi
          # A wheel is <name>-<version>-<tags>.whl; neither part holds a hyphen.
          name() { n="${1#dist/}"; printf '%s' "${n%%-*}" | tr '[:upper:]' '[:lower:]' | tr -s '._' '__'; }
          version() { v="${1#dist/*-}"; printf '%s' "${v%%-*}"; }
          wheel=""
          : > "$RUNNER_TEMP/workspace-pins"
          for f in dist/*.whl; do
            n="$(name "$f")"
            if [ "$n" = "$root" ]; then
              wheel="$f"
            else
              echo "$n==$(version "$f")" | tee -a "$RUNNER_TEMP/workspace-pins"
            fi
          done
          if [ -z "$wheel" ]; then
            echo "::error title=The workspace's root was not built::dist/ holds no wheel of $root. uv builds a workspace's root only when it is a package: one with a [build-system], or with package = true under [tool.uv]. Nothing was uploaded. Leave this tag where it is: plinth's tag ruleset, on a repository that has it, refuses to move or delete a v* tag. Make the root a package in a pull request, raise its version to one that has no tag yet, merge it, and tag the merged commit with it."
            exit 1
          fi
          printf '%s' "$wheel" > "$RUNNER_TEMP/workspace-root-wheel"
          echo "The root's wheel is $wheel."
      # On a `v*` tag, a listed member the root depends on is not uploaded
      # with it, so it must be on the index already, at a release within the
      # root's range: the member goes first, the root after. A pre-release
      # counts only where the root's range names one. `listed-pins` holds the
      # version found, for the install check below.
      - name: Check the index has each listed member the root needs
        run: |
          set -euo pipefail
          : > "$RUNNER_TEMP/listed-pins"
          if [ ! -s "$RUNNER_TEMP/release-needs" ]; then
            echo "The root needs no member released on its own tags."
            exit 0
          fi
          while IFS=$'\t' read -r need prefix; do
            if ! got="$(printf '%s\n' "$need" | uv pip compile - --no-config --no-deps --prerelease explicit --index-url "$INDEX_URL" --quiet --no-header --no-annotate 2>&1)"; then
              printf '%s\n' "$got"
              echo "::error title=A member the root needs is not on the index::The root's pyproject.toml asks for $need, and $INDEX_URL has no release of it within that range. Nothing was uploaded. A member listed under [tool.plinth.release] own-tags goes first: tag it ${prefix}v<version> and wait for that run to be green, then re-run this run's failed jobs (Re-run jobs on the run's page, or gh run rerun <run id> --failed): this tag stays as it is."
              exit 1
            fi
            pin="$(printf '%s\n' "$got" | sed '/^#/d' | grep -E '^[^ ]+==' || true)"
            if [ -z "$pin" ]; then
              printf '%s\n' "$got"
              echo "::error title=A member the root needs is not on the index::Resolving $need against $INDEX_URL gave no version, so this run cannot tell that the index has it. Nothing was uploaded."
              exit 1
            fi
            printf '%s\n' "$pin" | tee -a "$RUNNER_TEMP/listed-pins"
          done < "$RUNNER_TEMP/release-needs"
      # A software bill of materials (SBOM), attached to the GitHub Release.
      # The wheel names what it needs, not what it installs, so the SBOM is
      # of a fresh environment with the built wheel installed at the runtime
      # versions uv.lock names. It travels apart from dist/: the publish job
      # uploads dist/ whole, and PyPI refuses a file that is not a package.
      - name: Install syft (official release, SHA256 verified)
        env:
          GITHUB_TOKEN: ${{ github.token }}
          SYFT_VERSION: "1.55.0"
          SYFT_SHA256: "bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d"
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/syft"; mkdir -p "$d"
          f="syft_${SYFT_VERSION}_linux_amd64.tar.gz"
          curl -fsSL --retry 3 ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} -o "$d/$f" \
            "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/$f"
          echo "${SYFT_SHA256}  $d/$f" | sha256sum -c -
          tar -xzf "$d/$f" -C "$d" syft
          echo "$d" >> "$GITHUB_PATH"
      - name: Make the SBOM of the wheel and what it installs
        run: |
          set -euo pipefail
          env="$RUNNER_TEMP/sbom-env"
          uv venv --quiet "$env"
          if [ -s "$RUNNER_TEMP/workspace-root" ]; then
            # A workspace: the root's wheel alone. Its members are looked up
            # in dist/ too, each pinned to the version just built, so another
            # version on the index is not taken instead. This does not show
            # that PyPI has that member's code: a member changed without a
            # new version is skipped at the upload. A member released on its
            # own tags comes from the index, at the version found above.
            uv export --locked --no-dev --no-emit-workspace --no-hashes --quiet -o "$RUNNER_TEMP/constraints.txt"
            cat "$RUNNER_TEMP/workspace-pins" "$RUNNER_TEMP/listed-pins" >> "$RUNNER_TEMP/constraints.txt"
            listed="$(cat "$RUNNER_TEMP/listed-pins")"
            uv pip install --quiet --python "$env" --constraint "$RUNNER_TEMP/constraints.txt" --find-links dist ${listed:+--index "$INDEX_URL"} "$(cat "$RUNNER_TEMP/workspace-root-wheel")"
          else
            uv export --locked --no-dev --no-emit-project --no-hashes --quiet -o "$RUNNER_TEMP/constraints.txt"
            uv pip install --quiet --python "$env" --constraint "$RUNNER_TEMP/constraints.txt" dist/*.whl
          fi
          name="$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["name"])')"
          mkdir -p sbom
          syft scan "dir:$env" --source-name "$name" --source-version "${GITHUB_REF_NAME#v}" -o spdx-json=sbom/sbom.spdx.json
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: dist/
          if-no-files-found: error
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom
          path: sbom/
          if-no-files-found: error

  # The only job that can speak for this repository to PyPI, and it runs no
  # code from the repository: it uploads what `build` made.
  publish:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # The environment PyPI's publisher names. Its protection rules (who may
    # approve, which tags) are set in the repository's settings.
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
        with:
          # PyPI unless the repository variable PYPI_REPOSITORY_URL says
          # otherwise; https://test.pypi.org/legacy/ rehearses on TestPyPI.
          repository-url: ${{ vars.PYPI_REPOSITORY_URL || 'https://upload.pypi.org/legacy/' }}
          attestations: true
          # In a uv workspace a member whose version did not change is on
          # PyPI already: its files are skipped, and the rest are uploaded.
          # Without a workspace a file PyPI already has fails the run.
          skip-existing: ${{ needs.build.outputs.workspace == 'true' }}
      - name: Say why PyPI refused, in plain words
        if: failure()
        run: |
          {
            echo "### PyPI did not accept this release"
            echo
            echo "If the log of the step above says \`invalid-publisher\`, PyPI has no publisher registered for this project that matches this repository. On PyPI (or TestPyPI), add a pending publisher with this repository's owner and name, the workflow file \`release.yml\` and the environment \`pypi\`, then re-run this run's failed jobs (Re-run jobs on the run's page, or gh run rerun <run id> --failed): the tag stays as it is. In a uv workspace, every package it publishes needs its own publisher with those same values."
            echo
            echo "If it says the file already exists, this version was published before: PyPI never takes a version twice. Raise the version in pyproject.toml and tag again."
            echo
            echo "The steps, in order: docs/how-to/publish-a-release.md."
          } >> "$GITHUB_STEP_SUMMARY"
          echo "::error title=PyPI did not accept this release::Read the run summary for what to check. The steps: docs/how-to/publish-a-release.md."

  # The release page on GitHub, once PyPI has the files.
  github-release:
    needs: publish
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: sbom
          path: sbom/
      # The wheel and sdist PyPI has, and the SBOM beside them.
      - name: Create the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes dist/* sbom/sbom.spdx.json

# Publishes this package to PyPI when a version tag (`v1.2.3`) is pushed, then
# makes a GitHub Release with generated notes. The steps a person takes once
# before the first tag: docs/how-to/publish-a-release.md.
#
# Not a required check and not part of `ci`: it runs on a tag, never on a pull
# request, so no ruleset waits for it. No job is skipped with `if:`; each job
# runs or fails, so a red run says which step stopped.
#
# No stored secret. PyPI trusts this workflow through Trusted Publishing: the
# publish job asks GitHub for a short-lived identity token (`id-token: write`)
# and PyPI accepts it only from the repository, workflow file and environment
# registered as the project's publisher. The action also signs what it
# uploads (attestations), and PyPI shows that on the project page. The
# GitHub Release also carries an SBOM, `sbom.spdx.json`: what installing the
# wheel puts in an environment.
name: Release

on:
  push:
    tags: ["v*"]

# Nothing by default; each job asks for what it uses.
permissions: {}

# Two tags pushed together publish one after the other, never at once.
concurrency:
  group: release
  cancel-in-progress: false

jobs:
  # Checks before anything leaves the repository, then builds. A tag that
  # fails here uploads nothing.
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The whole history, to tell whether the tagged commit is on main.
          fetch-depth: 0
          persist-credentials: false   # nothing here pushes
      - name: Check the tag against pyproject.toml's version
        run: |
          set -euo pipefail
          tag="$GITHUB_REF_NAME"
          version="$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
          if [ "$tag" != "v$version" ]; then
            echo "::error title=The tag and the version differ::The tag is $tag, but pyproject.toml says version = \"$version\". Nothing was uploaded. Leave this tag where it is: plinth's tag ruleset, on a repository that has it, refuses to move or delete a v* tag. To release $version, tag a commit on main v$version. To release another version, change version in pyproject.toml in a pull request to one that has no tag yet, merge it, and tag the merged commit with it."
            exit 1
          fi
          echo "The tag $tag matches pyproject.toml's version $version."
      - name: Check the tagged commit is on main
        run: |
          set -euo pipefail
          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
            echo "::error title=The tag is not on main::$GITHUB_REF_NAME points at a commit that is not on main, so it never passed the checks a pull request needs. Nothing was uploaded. Leave this tag where it is: plinth's tag ruleset, on a repository that has it, refuses to move or delete a v* tag. Tag a commit on main with a version that has no tag yet."
            exit 1
          fi
          echo "$GITHUB_REF_NAME is on main."
      - name: Install uv (official release, SHA256 verified)
        env:
          UV_VERSION: "0.13.7"
          UV_SHA256: "c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83"
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/uv"; mkdir -p "$d"
          f="uv-x86_64-unknown-linux-gnu.tar.gz"
          curl -fsSL --retry 3 -o "$d/$f" \
            "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/$f"
          echo "${UV_SHA256}  $d/$f" | sha256sum -c -
          tar -xzf "$d/$f" -C "$d" --strip-components=1 "${f%.tar.gz}/uv" "${f%.tar.gz}/uvx"
          echo "$d" >> "$GITHUB_PATH"
      - run: uv build
      # A software bill of materials (SBOM), attached to the GitHub Release.
      # The wheel names what it needs, not what it installs, so the SBOM is
      # of a fresh environment with the built wheel installed at the runtime
      # versions uv.lock names. It travels apart from dist/: the publish job
      # uploads dist/ whole, and PyPI refuses a file that is not a package.
      - name: Install syft (official release, SHA256 verified)
        env:
          SYFT_VERSION: "1.55.0"
          SYFT_SHA256: "bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d"
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/syft"; mkdir -p "$d"
          f="syft_${SYFT_VERSION}_linux_amd64.tar.gz"
          curl -fsSL --retry 3 -o "$d/$f" \
            "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/$f"
          echo "${SYFT_SHA256}  $d/$f" | sha256sum -c -
          tar -xzf "$d/$f" -C "$d" syft
          echo "$d" >> "$GITHUB_PATH"
      - name: Make the SBOM of the wheel and what it installs
        run: |
          set -euo pipefail
          env="$RUNNER_TEMP/sbom-env"
          uv export --locked --no-dev --no-emit-project --no-hashes --quiet -o "$RUNNER_TEMP/constraints.txt"
          uv venv --quiet "$env"
          uv pip install --quiet --python "$env" --constraint "$RUNNER_TEMP/constraints.txt" dist/*.whl
          name="$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["name"])')"
          mkdir -p sbom
          syft scan "dir:$env" --source-name "$name" --source-version "${GITHUB_REF_NAME#v}" -o spdx-json=sbom/sbom.spdx.json
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: dist/
          if-no-files-found: error
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom
          path: sbom/
          if-no-files-found: error

  # The only job that can speak for this repository to PyPI, and it runs no
  # code from the repository: it uploads what `build` made.
  publish:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # The environment PyPI's publisher names. Its protection rules (who may
    # approve, which tags) are set in the repository's settings.
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
        with:
          # PyPI unless the repository variable PYPI_REPOSITORY_URL says
          # otherwise; https://test.pypi.org/legacy/ rehearses on TestPyPI.
          repository-url: ${{ vars.PYPI_REPOSITORY_URL || 'https://upload.pypi.org/legacy/' }}
          attestations: true
      - name: Say why PyPI refused, in plain words
        if: failure()
        run: |
          {
            echo "### PyPI did not accept this release"
            echo
            echo "If the log of the step above says \`invalid-publisher\`, PyPI has no publisher registered for this project that matches this repository. On PyPI (or TestPyPI), add a pending publisher with this repository's owner and name, the workflow file \`release.yml\` and the environment \`pypi\`, then re-run this run's failed jobs (Re-run jobs on the run's page, or gh run rerun <run id> --failed): the tag stays as it is."
            echo
            echo "If it says the file already exists, this version was published before: PyPI never takes a version twice. Raise the version in pyproject.toml and tag again."
            echo
            echo "The steps, in order: docs/how-to/publish-a-release.md."
          } >> "$GITHUB_STEP_SUMMARY"
          echo "::error title=PyPI did not accept this release::Read the run summary for what to check. The steps: docs/how-to/publish-a-release.md."

  # The release page on GitHub, once PyPI has the files.
  github-release:
    needs: publish
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: sbom
          path: sbom/
      # The wheel and sdist PyPI has, and the SBOM beside them.
      - name: Create the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes dist/* sbom/sbom.spdx.json

# Did an accepted reviewer account leave a review signal on this commit? This
# repository's call of coolbress/plinth's reusable pr-review.yml; the check is
# `third-party / review`. It is evidence of participation, not a verdict and
# not proof that the findings were handled:
# https://github.com/coolbress/plinth/blob/main/docs/how-to/configure-the-third-party-reviewer.md
#
# It reports and is not required: the ruleset does not name it, so a reviewer
# that never comes leaves a red check after its wait, not a locked pull
# request. Requiring it is a separate step, once it has reported on a pull
# request: section 3 of the how-to, plinth's scripts/upgrade-ruleset.sh.
#
# Its own file and not ci.yml: it also runs on `pull_request_review`, so it
# turns green the moment a review arrives, and that trigger in ci.yml would
# re-run the whole CI on every review.
#
# Pinned at the commit the `ci` job in ci.yml calls; Dependabot's
# `github-actions` entry raises both together.
name: third-party

on:
  pull_request:
    # `ready_for_review`: a draft is not sent for review; the first review
    # happens the moment the pull request is marked ready.
    types: [opened, synchronize, reopened, ready_for_review]
  pull_request_review:
    types: [submitted]

permissions:
  contents: read
  pull-requests: read    # the summons, when posted, goes out with summons-token, never with this token

# One run at a time per pull request. Never cancel: a review arriving starts a
# `pull_request_review` run, and cancelling the waiting one would read as red.
concurrency:
{% raw %}  group: third-party-${{ github.event.pull_request.number }}
{% endraw %}  cancel-in-progress: false

jobs:
  # Keep the job name `third-party`: the check name comes from it.
  third-party:
    uses: coolbress/plinth/.github/workflows/pr-review.yml@{{ plinth_sha }}
    secrets:
      # Optional: a fine-grained token of yours, this repository only, with an
      # expiry and Pull requests: Read and write, for the summons the check
      # posts when no review has started a third of the way into its wait.
      # Unset, it is empty: the check reads reviews and posts nothing.
{% raw %}      summons-token: ${{ secrets.SUMMONS_TOKEN }}
{% endraw %}

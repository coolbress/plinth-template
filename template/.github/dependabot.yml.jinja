# Dependency updates. A person cannot check versions weekly; without this the
# pins age in silence.
version: 2
updates:
  - package-ecosystem: "uv"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    # Grouped: one pull request per group, not one per package. Security
    # updates bypass grouping and schedule and open at once, so grouping never
    # delays a CVE fix. No cooldown: a three-day wait is GitHub's default.
    groups:
      # Development tools (ruff, mypy, pytest) in one pull request; a break
      # here breaks CI, not the product.
      dev-tools:
        dependency-type: "development"
      # Runtime dependencies: minor and patch together. A major comes alone,
      # because it may break and is reviewed on its own.
      runtime-minor:
        dependency-type: "production"
        update-types: ["minor", "patch"]

  # The reusable workflows are pinned to a commit SHA of coolbress/plinth.
  # Dependabot raises the SHA and the version comment beside it.
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      actions:
        patterns: ["*"]
{%- if archetype in ['backend', 'data-ml'] %}
  # Base images are pinned by digest; Dependabot raises them the same way.
  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    # Digests and patches only. A Python minor moves the build stage, the run
    # stage, `.python-version` and mypy's target together: that is a decision,
    # not an update. Measured (plinth #120): `python:3.12-slim` to `3.14-slim`
    # was green on every required check and could not start, because the
    # virtualenv copied from the 3.12 build stage pointed at an interpreter the
    # run image did not have.
    ignore:
      - dependency-name: "*"
        update-types: ["version-update:semver-major", "version-update:semver-minor"]
{%- endif %}

# Configuration is externalised into the environment (12-Factor III), never
# hard-coded.
#
# This file holds keys only. Real values go in .env, which is never committed.
# It is how a newcomer learns what to fill in.
#
{% if host == 'gitlab' %}# Keep it complete: every os.environ / os.getenv key the source uses belongs
# here. On GitHub `ci / floor-check` checks that; on GitLab no job reads it yet.{% else %}# This is a check, not a convention: `ci / floor-check` reads every
# os.environ / os.getenv key the source uses and expects it here.{% endif %}

{% if archetype == 'web' -%}
# Local work: DJANGO_DEBUG=1 and a DJANGO_SECRET_KEY of this computer's own,
# the two lines the README's "Run it on your computer" writes; the rest stay
# empty (the database is db.sqlite3) and `manage.py runserver` serves. Without
# a key one is made per process, and each restart logs everyone out.
# Production sets the other keys in the host's environment;
# `python -m <package>` refuses to start without them.
# Render sets RENDER_EXTERNAL_HOSTNAME itself on a web service: it stands in
# for DJANGO_ALLOWED_HOSTS, which then only needs a custom domain. Leave it
# empty here.
# DJANGO_DEBUG=
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=
# RENDER_EXTERNAL_HOSTNAME=
# DATABASE_URL=
# PORT=8000
{% else -%}
# APP_ENV=development
# DATABASE_URL=
{% endif -%}

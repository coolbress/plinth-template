# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage reports, from a local run or CI
.coverage
coverage.xml
htmlcov/

# Real values are never committed; only .env.example is.
.env
.env.*
!.env.example

# Django's local database (the web archetype, when DATABASE_URL is unset) and
# its collected static files
db.sqlite3
staticfiles/

# OS
.DS_Store

# Claude Code's personal settings. Only .claude/settings.json is committed:
# Claude Code adds this file to the global git excludes of one machine, which
# protects that machine and not the repository.
.claude/settings.local.json
# A worktree under here is another checkout, not content: `git add .` would
# otherwise stage it as a gitlink.
.claude/worktrees/

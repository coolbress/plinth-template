[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "One line saying what this is"
readme = "README.md"
requires-python = ">=3.12"
license = "{{ license }}"
license-files = ["LICENSE"]
{%- if owner %}
authors = [{ name = "{{ owner }}" }]
{%- endif %}
{%- if archetype in ['cli', 'library'] %}
# The package ships `py.typed`: a type checker reads its annotations.
classifiers = ["Typing :: Typed"]
{%- endif %}
{%- if archetype == 'web' %}
dependencies = [
    # The LTS series: security fixes to April 2028 (djangoproject.com/download).
    "django>=5.2,<5.3",
    "psycopg[binary]>=3.2",
    "uvicorn>=0.30",
    # Serves the collected static files (the admin's CSS and JavaScript) from the app.
    "whitenoise>=6.6",
]
{%- elif archetype == 'data-ml' %}
dependencies = [
    # The starting model and how it is saved: skops writes a format that
    # loading cannot run code from, unlike a pickle (docs/how-to/publish-a-release.md).
    "scikit-learn>=1.9",
    "skops>=0.16",
]
{%- else %}
dependencies = []
{%- endif %}
{%- if archetype == 'cli' %}

# The command `pip install` or `uv tool install` puts on PATH. It runs what
# `python -m {{ package_name }}` runs, and has the distribution's name, which
# `uvx {{ package_name }}` and `pipx run` look for.
[project.scripts]
{{ package_name }} = "{{ package_name }}.__main__:main"
{%- endif %}
{%- if owner %}

{% if host == 'gitlab' %}# Distribution metadata. Read by `pip show` and package indexes{% else %}# Distribution metadata. Read by `pip show`, GitHub and the dependency graph{% endif %}
# even when the package is never uploaded.
[project.urls]
{% if host == 'gitlab' %}Homepage = "https://gitlab.com/{{ owner }}/{{ project_name }}"
Issues = "https://gitlab.com/{{ owner }}/{{ project_name }}/-/issues"{% else %}Homepage = "https://github.com/{{ owner }}/{{ project_name }}"
Issues = "https://github.com/{{ owner }}/{{ project_name }}/issues"{% endif %}
{%- endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = [
{%- if archetype == 'web' %}
    # The stubs' series follows Django's; mypy's plugin loads the settings.
    "django-stubs>=5.2,<5.3",
{%- endif %}
    "mypy>=1.14",
    "pytest>=8.3",
{%- if archetype == 'web' %}
    "pytest-django>=4.9",
{%- endif %}
    "ruff>=0.9",
]

# Linter and formatter. The configuration is committed; CI runs `ruff check`
{% if host == 'gitlab' %}# and `ruff format --check` as `lint`.{% else %}# and `ruff format --check` as `ci / lint`.{% endif %}
[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "S", "A", "C4", "PT", "SIM", "RUF"]

[tool.ruff.lint.per-file-ignores]
# assert is the normal form in tests
"tests/**" = ["S101"]
{%- if archetype == 'web' %}
# Django's makemigrations writes `dependencies` and `operations` as class-level
# lists in every migration it generates.
"src/**/migrations/*.py" = ["RUF012"]
{%- endif %}

{% if host == 'gitlab' %}# Type checking, `typecheck`.{% else %}# Type checking, `ci / typecheck`.{% endif %}
[tool.mypy]
strict = true
python_version = "3.12"
files = ["src", "tests"]
{%- if archetype == 'web' %}
plugins = ["mypy_django_plugin.main"]

[tool.django-stubs]
django_settings_module = "{{ package_name }}.settings"
{%- endif %}
{%- if archetype == 'data-ml' %}

# scikit-learn and skops ship no type information; what they return is
# checked by the tests instead.
[[tool.mypy.overrides]]
module = ["sklearn.*", "skops.*"]
ignore_missing_imports = true
{%- endif %}

{% if host == 'gitlab' %}# Tests, `test`.{% else %}# Tests, `ci / test`.{% endif %}
[tool.pytest.ini_options]
testpaths = ["tests"]
{%- if archetype == 'web' %}
DJANGO_SETTINGS_MODULE = "{{ package_name }}.settings"
{%- endif %}
# No silent failures: an unregistered `@pytest.mark.foo` is a no-op even when
# it is a typo, and a misspelt key in this section is ignored. Both are made
# errors.
addopts = ["--strict-markers", "--strict-config"]
# Warnings are errors. A third-party warning that blocks gets one narrow
# ignore here, with its reason.
filterwarnings = ["error"]

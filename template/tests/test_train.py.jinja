"""The training run as the release workflow runs it: `python -m {{ package_name }} train`.

It writes the three files a release publishes, the metrics parse as named
numbers, the model loads back with skops trusting nothing extra and answers
as it did, the card's results are filled in, the card says how the model
was made (the scikit-learn and skops versions, the commit, the seed), and
nothing is a pickle.
"""

from __future__ import annotations

import json
import subprocess
import sys
from importlib.metadata import version
from pathlib import Path

import pytest
import skops.io

from {{ package_name }}.train import (
    NO_COMMIT,
    OUTPUTS,
    RESULTS,
    SEED,
    load_sample,
    source_commit,
    train,
)

CARD = Path(__file__).resolve().parents[1] / "MODEL_CARD.md"

#: Formats that run code when loaded. A release never carries one.
PICKLES = (".pkl", ".pickle", ".joblib", ".pt")


def test_the_run_writes_what_a_release_publishes(tmp_path: Path) -> None:
    command = ["train", "--out", str(tmp_path), "--card", str(CARD)]
    done = subprocess.run(  # noqa: S603
        [sys.executable, "-m", "{{ package_name }}", *command],
        capture_output=True,
        text=True,
        check=False,
        timeout=120,
    )
    assert done.returncode == 0, f"exit {done.returncode}\n{done.stdout}\n{done.stderr}"
    assert sorted(p.name for p in tmp_path.iterdir()) == sorted(OUTPUTS)
    logged = [json.loads(line) for line in done.stdout.splitlines() if line]
    assert [r["message"] for r in logged] == ["trained"], done.stdout


def test_the_metrics_are_named_numbers_and_the_card_holds_them(tmp_path: Path) -> None:
    metrics = train(tmp_path, CARD)
    written = json.loads((tmp_path / "metrics.json").read_text(encoding="utf-8"))
    assert written == metrics
    assert written, "no metrics written"
    for name, value in written.items():
        assert type(value) in (int, float), name
    # The starting model on the starting sample; a real model sets its own floor.
    assert written["accuracy"] >= 0.9, written
    card = (tmp_path / "MODEL_CARD.md").read_text(encoding="utf-8")
    assert RESULTS not in card
    assert f"| `accuracy` | {written['accuracy']} |" in card
    assert "Does the training data hold personal information?" in card
    assert RESULTS in CARD.read_text(encoding="utf-8"), "the committed card was changed"


def test_the_model_loads_without_trusting_anything_extra(tmp_path: Path) -> None:
    train(tmp_path, CARD)
    path = tmp_path / "model.skops"
    assert skops.io.get_untrusted_types(file=path) == []
    model = skops.io.load(path)
    features, _ = load_sample()
    assert len(model.predict(features[:5])) == 5


def test_nothing_written_is_a_pickle(tmp_path: Path) -> None:
    train(tmp_path, CARD)
    for name in OUTPUTS:
        assert not name.endswith(PICKLES), name
    assert not [p for p in tmp_path.rglob("*") if p.name.endswith(PICKLES)]


#: The rows that say how a run was made. A release whose card lacks one
#: cannot be loaded with a known scikit-learn, or made again.
MADE_WITH = ("scikit-learn", "skops", "commit", "seed")


def made_with_rows(card: str) -> dict[str, str]:
    """The `| `name` | value |` rows of the card's "How it was made" table."""
    table = card[card.index("| How it was made | Value |") :].split("\n\n", 1)[0]
    rows = [line.split("|")[1:3] for line in table.splitlines()[2:]]
    return {name.strip().strip("`"): value.strip() for name, value in rows}


#: A commit in a scratch repository, whatever the machine's git settings.
GIT_IDENTITY = ("-c", "user.name=t", "-c", "user.email=t@example.com", "-c", "commit.gpgsign=false")


def _git(where: Path, *args: str) -> str:
    done = subprocess.run(  # noqa: S603
        ["git", *GIT_IDENTITY, *args],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
        cwd=where,
    )
    return done.stdout.strip()


def test_the_card_says_how_the_model_was_made(tmp_path: Path) -> None:
    train(tmp_path, CARD)
    rows = made_with_rows((tmp_path / "MODEL_CARD.md").read_text(encoding="utf-8"))
    missing = [name for name in MADE_WITH if not rows.get(name)]
    assert not missing, f"the card does not say: {missing}\n{rows}"
    assert rows["scikit-learn"] == version("scikit-learn")
    assert rows["skops"] == version("skops")
    assert rows["seed"] == str(SEED)
    assert rows["commit"] == source_commit(Path.cwd())
    metrics = json.loads((tmp_path / "metrics.json").read_text(encoding="utf-8"))
    assert not set(MADE_WITH) & set(metrics), "metrics.json holds numbers only"


def test_the_commit_is_the_one_checked_out(tmp_path: Path) -> None:
    _git(tmp_path, "init", "-q")
    _git(tmp_path, "commit", "-q", "--allow-empty", "-m", "a commit")
    assert source_commit(tmp_path) == _git(tmp_path, "rev-parse", "HEAD")


def test_outside_a_repository_the_card_says_there_is_no_commit(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A fresh render is not a git repository yet: the run still trains, and
    its card says so rather than naming a commit. A release never sees this:
    its workflow refuses a card whose commit is not the tagged one."""
    monkeypatch.setenv("GIT_CEILING_DIRECTORIES", str(tmp_path.parent))
    monkeypatch.chdir(tmp_path)
    train(tmp_path / "out", CARD)
    rows = made_with_rows((tmp_path / "out" / "MODEL_CARD.md").read_text(encoding="utf-8"))
    assert rows["commit"] == NO_COMMIT

"""The page, run as Streamlit runs it, with no browser (`AppTest`)."""

from pathlib import Path

from streamlit.testing.v1 import AppTest

SRC = Path(__file__).resolve().parents[1] / "src"
APP = SRC / "{{ package_name }}" / "app.py"


def test_the_page_shows_the_table_and_the_chart() -> None:
    # The first run imports Streamlit's chart libraries, which can take longer
    # than its three-second default on a cold machine.
    page = AppTest.from_file(str(APP), default_timeout=60).run()
    assert not page.exception, [e.value for e in page.exception]
    assert len(page.dataframe) == 1
    assert len(page.get("vega_lite_chart")) == 1

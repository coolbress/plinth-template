"""`claude.ask` with a fake client: canned answers, no key, no network.

Copy `FakeClient` into a test of your own code that calls Claude: pass it
where the code takes the client. A test that makes the real client fails
(`tests/conftest.py`).
"""

from __future__ import annotations

import logging
from pathlib import Path

import pytest
from anthropic.types import Message, MessageParam, TextBlock, Usage

from {{ package_name }} import claude

PACKAGE = Path(claude.__file__).parent


class FakeMessages:
    """Answers every message with `answer`, and keeps what it was sent."""

    def __init__(self, answer: str, stop_reason: str = "end_turn") -> None:
        self.answer = answer
        self.stop_reason = stop_reason
        self.sent: list[dict[str, object]] = []

    def create(
        self, *, model: str, max_tokens: int, system: str, messages: list[MessageParam]
    ) -> Message:
        self.sent.append({"model": model, "system": system, "messages": messages})
        return Message.model_validate(
            {
                "id": "msg_fake",
                "type": "message",
                "role": "assistant",
                "model": model,
                "content": [TextBlock(type="text", text=self.answer)],
                "stop_reason": self.stop_reason,
                "stop_sequence": None,
                "usage": Usage(input_tokens=10, output_tokens=5),
            }
        )


class FakeClient:
    def __init__(self, answer: str = "A canned answer.", stop_reason: str = "end_turn") -> None:
        self.messages = FakeMessages(answer, stop_reason)


def test_ask_returns_the_answer_and_sends_the_prompt_file() -> None:
    client = FakeClient("Open from nine to five.")
    assert claude.ask("When are you open?", client) == "Open from nine to five."
    (sent,) = client.messages.sent
    assert sent["model"] == claude.MODEL
    assert sent["system"] == (PACKAGE / "prompts" / "system.md").read_text(encoding="utf-8")
    assert sent["messages"] == [{"role": "user", "content": "When are you open?"}]


def test_a_refusal_is_an_error_not_an_empty_answer() -> None:
    with pytest.raises(claude.RefusedError):
        claude.ask("Anything.", FakeClient("", stop_reason="refusal"))


def test_no_message_or_answer_text_reaches_the_logs(caplog: pytest.LogCaptureFixture) -> None:
    """Sizes and timings only: a log line that prints a message keeps it."""
    caplog.set_level(logging.DEBUG)
    claude.ask("my address is 1 Private Lane", FakeClient("noted: 1 Private Lane"))
    assert caplog.records, "ask logged nothing"
    for record in caplog.records:
        written = repr(record.__dict__)
        assert "Private Lane" not in written, written


def test_the_model_is_named_once_in_the_package() -> None:
    named = [
        path
        for path in PACKAGE.rglob("*")
        if path.is_file()
        and "__pycache__" not in path.parts
        and claude.MODEL in path.read_text(encoding="utf-8", errors="ignore")
    ]
    assert [p.name for p in named] == ["claude.py"], named
    assert (PACKAGE / "claude.py").read_text(encoding="utf-8").count(claude.MODEL) == 1


def test_without_a_key_the_client_is_not_made() -> None:
    with pytest.raises(claude.MissingKeyError):
        claude.make_client()


def test_a_test_that_makes_the_real_client_fails(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("ANTHROPIC_API_KEY", "sk-ant-not-a-real-key")
    with pytest.raises(pytest.fail.Exception, match="real Anthropic client"):
        claude.make_client()

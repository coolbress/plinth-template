"""What the pages carry for a screen reader and a phone, checked on the HTML Django serves.

axe-core, which `ci / web-audit` runs, reports a page with no `lang`, content
outside a `<main>` landmark, or a field with no label. These read the same
three facts from the served page, so a template that drops one fails here
before a browser opens it. Every page also carries the viewport `<meta>`:
without it a phone draws the page at desktop width, shrunk.

A note that is refused says why next to its field: the field carries
`aria-invalid` and an `aria-describedby` that names the message (WCAG 2.2,
3.3.1), keeps what was typed, and nothing is saved.

The error pages are Django's deployment checklist: with `DEBUG` off, a
missing page and a server error are answered from `404.html` and
`500.html`, not Django's bare default.
"""

from __future__ import annotations

import secrets
from html.parser import HTMLParser

import pytest
{% if custom_user_model | string | lower == 'true' %}from django.contrib.auth import get_user_model
{% else %}from django.contrib.auth.models import User
{% endif %}from django.test import Client, RequestFactory
from django.views.defaults import server_error
{% if custom_user_model | string | lower == 'true' %}
User = get_user_model()
{% endif %}
#: What may sit outside `<main>`: the document's own head.
HEAD = {"html", "head", "title", "meta", "link"}

#: Elements with no end tag, so never open around text.
VOID = {"input", "meta", "link", "br", "img", "hr"}


class Page(HTMLParser):
    """The `lang` on `<html>`, how many `<main>`, what sits outside it,
    which fields have no label, each field's attributes and the text of each
    element with an `id`."""

    def __init__(self, html: str) -> None:
        super().__init__()
        self.lang = ""
        self.mains = 0
        self.depth = 0
        self.outside: list[str] = []
        self.fields: dict[str, str] = {}
        self.labelled: set[str] = set()
        self.viewport = ""
        self.attrs: dict[str, dict[str, str]] = {}
        self.text: dict[str, str] = {}
        self.open: list[tuple[str, str]] = []
        self.feed(html)
        self.close()

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        a = {k: v or "" for k, v in attrs}
        if tag == "html":
            self.lang = a.get("lang", "")
        elif tag == "meta" and a.get("name") == "viewport":
            self.viewport = a.get("content", "")
        elif tag == "main":
            self.mains += 1
            self.depth += 1
        elif not self.depth and tag not in HEAD:
            self.outside.append(tag)
        if tag == "label" and a.get("for"):
            self.labelled.add(a["for"])
        if tag in ("input", "textarea", "select") and a.get("type") not in ("hidden", "submit"):
            self.fields[a.get("name", "?")] = a.get("id", "")
            self.attrs[a.get("name", "?")] = a
        if a.get("id") and tag not in VOID:
            self.text[a["id"]] = ""
            self.open.append((tag, a["id"]))

    def handle_endtag(self, tag: str) -> None:
        if tag == "main":
            self.depth -= 1
        if self.open and self.open[-1][0] == tag:
            self.open.pop()

    def handle_data(self, data: str) -> None:
        for _, id_ in self.open:
            self.text[id_] += data

    def unlabelled(self) -> list[str]:
        return [name for name, id_ in self.fields.items() if not id_ or id_ not in self.labelled]


def check(html: str, *, fields: bool = True) -> Page:
    page = Page(html)
    assert page.lang, "<html> has no lang attribute"
    assert "width=device-width" in page.viewport, "no viewport <meta> for phones"
    assert page.mains == 1, f"{page.mains} <main> elements, not one"
    assert page.outside == [], f"outside <main>: {page.outside}"
    if fields:
        assert page.fields, "no field on the page"
    assert page.unlabelled() == [], f"fields with no <label for>: {page.unlabelled()}"
    return page


def test_the_log_in_page(client: Client) -> None:
    check(client.get("/accounts/login/", secure=True).content.decode())


@pytest.mark.django_db
def test_the_notes_page_and_a_note(client: Client) -> None:
    client.force_login(User.objects.create_user("dana", password=secrets.token_urlsafe()))
    check(client.get("/", secure=True).content.decode())
    written = client.post("/", {"text": "buy bread"}, secure=True)
    assert written.status_code == 302
    check(client.get(written["Location"], secure=True).content.decode())


def refused(page: Page, field: str, why: str) -> None:
    """The field is marked invalid and points at the message that says `why`
    (WCAG 2.2, 3.3.1 error identification)."""
    attrs = page.attrs[field]
    assert attrs.get("aria-invalid") == "true", f"{field} is not marked aria-invalid"
    described = attrs.get("aria-describedby", "")
    assert described in page.text, f"{field}'s aria-describedby names no element"
    assert why in page.text[described], f"{described!r} does not say why: {page.text[described]!r}"


BLANK = "Write the note first: a note of only spaces is not saved."


@pytest.mark.django_db
def test_a_blank_note_is_refused_saying_why(client: Client) -> None:
    client.force_login(User.objects.create_user("dana", password=secrets.token_urlsafe()))
    answer = client.post("/", {"text": "   "}, secure=True)
    assert answer.status_code == 200
    page = check(answer.content.decode())
    refused(page, "text", BLANK)
    assert page.attrs["text"].get("value") == "   ", "what was typed is lost"
    assert "None yet." in client.get("/", secure=True).content.decode(), "a note was created"


@pytest.mark.django_db
def test_a_note_saved_blank_is_refused_saying_why_and_kept(client: Client) -> None:
    client.force_login(User.objects.create_user("dana", password=secrets.token_urlsafe()))
    url = client.post("/", {"text": "buy bread"}, secure=True)["Location"]
    answer = client.post(url, {"text": "   "}, secure=True)
    assert answer.status_code == 200
    page = check(answer.content.decode())
    refused(page, "text", BLANK)
    assert page.attrs["text"].get("value") == "   ", "what was typed is lost"
    assert Page(client.get(url, secure=True).content.decode()).text["text"] == "buy bread"


FIELD = '<label for="n">Note</label><input id="n" name="text">'
VIEWPORT = '<meta name="viewport" content="width=device-width, initial-scale=1">'
WHOLE = f'<html lang="en">{VIEWPORT}<title>t</title><main>{FIELD}</main>'


def test_a_whole_page_passes() -> None:
    check(WHOLE)


@pytest.mark.parametrize(
    ("html", "missing"),
    [
        (WHOLE.replace(' lang="en"', ""), "lang"),
        (WHOLE.replace(VIEWPORT, ""), "viewport"),
        (WHOLE.replace("<main>", "").replace("</main>", ""), "<main>"),
        (WHOLE.replace("<main>", "<h1>Notes</h1><main>"), "outside"),
        (WHOLE.replace('<label for="n">Note</label>', ""), "label"),
        (WHOLE.replace(' for="n"', ""), "label"),
    ],
)
def test_a_page_missing_one_fails(html: str, missing: str) -> None:
    with pytest.raises(AssertionError, match=missing):
        check(html)


@pytest.mark.django_db
def test_a_missing_page_is_answered_from_404_html(client: Client) -> None:
    client.force_login(User.objects.create_user("dana", password=secrets.token_urlsafe()))
    response = client.get("/no-such-page/", secure=True)
    assert response.status_code == 404
    assert "404.html" in [t.name for t in response.templates]
    check(response.content.decode(), fields=False)


def test_a_server_error_is_answered_from_500_html() -> None:
    """Django's handler renders `500.html` with no context, so it must stand alone."""
    response = server_error(RequestFactory().get("/"))
    assert response.status_code == 500
    html = response.content.decode()
    assert "<h1>Server Error (500)</h1>" not in html, "Django's bare default, not 500.html"
    check(html, fields=False)

# Python
__pycache__/
*.py[cod]
.venv/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The rest of what an instance ignores, inside `template/`: its own copy is
# `template/.gitignore.jinja`, which git does not read
# (coolbress/plinth-template#260).
/template/**/build/
/template/**/htmlcov/
/template/**/staticfiles/
/template/**/.ipynb_checkpoints/
/template/**/.coverage
/template/**/coverage.xml
/template/**/db.sqlite3

# Real values are never committed; only .env.example is.
.env
.env.*
!.env.example

# OS
.DS_Store

# Claude Code's personal settings. Only .claude/settings.json is committed:
# Claude Code adds this file to the global git excludes of one machine, which
# protects that machine and not the repository.
.claude/settings.local.json

# Worktrees made by CONTRIBUTING.md step 1. While one is there untracked,
# CONTRIBUTING.md's `copier copy --vcs-ref HEAD .` fails.
.claude/worktrees/
